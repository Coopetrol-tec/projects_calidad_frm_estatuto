# Copie este archivo como .env.production en el servidor y cambie los valores.
# NO lo suba al repositorio.

# --- Aplicación ---
# Genere una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave
# Genere con: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SuClave'))"
# IMPORTANTE: el hash contiene "$"; escríbalo entre comillas SIMPLES para que
# Docker Compose no lo interprete como variable. Ej.: ADMIN_PASSWORD_HASH='scrypt:32768:8:1$abc$def'
ADMIN_PASSWORD_HASH=''
APP_NAME=Propuestas de ajuste al Estatuto

# Publicación detrás de https://sistemas.coopetrol.coop:8546/estatutos
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=estatutos_session

# --- Base de datos (contenedor "db") ---
POSTGRES_DB=formulario_estatuto
POSTGRES_USER=estatuto_app
POSTGRES_PASSWORD=cambie-esta-clave-db

DB_ENGINE=postgres
# Debe usar el MISMO usuario/clave/base de arriba y el host "db".
# Si la clave tiene caracteres especiales (@ : / # ?), codifíquelos en URL o use solo letras y números.
DATABASE_URL=postgresql://estatuto_app:cambie-esta-clave-db@db:5432/formulario_estatuto

SECRET_KEY=cambie-esta-clave-para-produccion
ADMIN_PASSWORD=
APP_NAME=Propuestas de ajuste al Estatuto

DB_ENGINE=sqlite

# Más adelante, para PostgreSQL cambie DB_ENGINE y defina DATABASE_URL:
# DB_ENGINE=postgres
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/formulario_estatuto

# --- Notificaciones por correo (confirmación al pulsar "Finalizar registro") ---
# Si EMAIL_HOST o DEFAULT_FROM_EMAIL están vacíos, no se envía correo (queda registrado como "deshabilitado").
# Puerto 587 con EMAIL_USE_TLS=true (STARTTLS) o 465 con EMAIL_USE_SSL=true. No active ambos.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Admite "Nombre <correo@dominio>"
DEFAULT_FROM_EMAIL=

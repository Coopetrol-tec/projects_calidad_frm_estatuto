# Para docker-compose.windows.yml. Copie como .env.production y cambie los valores.

# Genere una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave
# Entre comillas SIMPLES (el hash contiene "$").
ADMIN_PASSWORD_HASH=''
APP_NAME=Propuestas de ajuste al Estatuto

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=estatutos_session

# SQLite dentro del volumen estatuto_instance (C:\app\instance\app.db).
DB_ENGINE=sqlite
# Para usar PostgreSQL (solo cuando ya esté instalado y acepte conexiones del contenedor):
# - Use la IP del servidor de PostgreSQL. "host.docker.internal" NO existe en Docker Engine
#   para Windows y la aplicación no arranca.
# - La base empieza vacía: migre antes los datos de SQLite.
# DB_ENGINE=postgres
# DATABASE_URL=postgresql://usuario:clave@10.10.55.3:5432/formulario_estatuto

# --- Notificaciones por correo (confirmación al pulsar "Finalizar registro") ---
# Si EMAIL_HOST o DEFAULT_FROM_EMAIL están vacíos, no se envía correo (queda registrado como "deshabilitado").
# Puerto 587 con EMAIL_USE_TLS=true (STARTTLS) o 465 con EMAIL_USE_SSL=true. No active ambos.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Admite "Nombre <correo@dominio>". SIN comillas: actualizar.ps1 rechaza valores entre comillas.
DEFAULT_FROM_EMAIL=

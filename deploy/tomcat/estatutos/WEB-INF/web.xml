<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proxy de Tomcat hacia el contenedor Docker del Formulario del Estatuto.
  https://sistemas.coopetrol.coop:8546/estatutos/*  ->  http://127.0.0.1:8547/estatutos/*
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Estatutos (proxy a Docker)</display-name>

  <servlet>
    <servlet-name>estatutos</servlet-name>
    <servlet-class>org.mitre.dsmiley.httpproxy.ProxyServlet</servlet-class>
    <init-param>
      <param-name>targetUri</param-name>
      <param-value>http://127.0.0.1:8547/estatutos</param-value>
    </init-param>
    <!-- Envía X-Forwarded-For y X-Forwarded-Proto (https) a la aplicación -->
    <init-param>
      <param-name>forwardip</param-name>
      <param-value>true</param-value>
    </init-param>
    <!-- Conserva el host público (sistemas.coopetrol.coop:8546) -->
    <init-param>
      <param-name>preserveHost</param-name>
      <param-value>true</param-value>
    </init-param>
    <!-- Conserva el nombre de la cookie de sesión de la aplicación -->
    <init-param>
      <param-name>preserveCookies</param-name>
      <param-value>true</param-value>
    </init-param>
    <!-- Las redirecciones las sigue el navegador, no el proxy -->
    <init-param>
      <param-name>http.protocol.handle-redirects</param-name>
      <param-value>false</param-value>
    </init-param>
    <!-- Reprocesar el PDF del Estatuto puede tardar -->
    <init-param>
      <param-name>http.socket.timeout</param-name>
      <param-value>180000</param-value>
    </init-param>
    <init-param>
      <param-name>http.read.timeout</param-name>
      <param-value>180000</param-value>
    </init-param>
    <init-param>
      <param-name>log</param-name>
      <param-value>false</param-value>
    </init-param>
  </servlet>

  <servlet-mapping>
    <servlet-name>estatutos</servlet-name>
    <url-pattern>/*</url-pattern>
  </servlet-mapping>
</web-app>
